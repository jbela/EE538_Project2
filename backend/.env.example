# Copy this file to .env in the same backend/ folder and fill in your key.
# Do NOT commit .env — it contains a secret.

# Required for chat, citations, and Whisper transcription.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults shown.
# - gpt-5.2 is a good default ($1.75/$14 per 1M tokens, 1M context).
# - gpt-5.5 is the strongest model but ~3x more expensive.
# - gpt-4o-mini is the cheapest but lower quality.
OPENAI_MODEL=gpt-5.2

# Optional. The Whisper speech-to-text model used for /jobs file uploads.
WHISPER_MODEL=whisper-1
